# Copy to a gitignored .env on the server. Leave every secret empty in git.
# Never commit real values.

# Kalshi trade API key id. Orders are refused without it.
KALSHI_API_KEY_ID=

# PEM contents of the Kalshi private key. Newlines may be written as \n.
# RSA-PSS SHA-256. Orders are refused without it.
KALSHI_PRIVATE_KEY_PEM=

# Approval password. Checked with a constant-time compare.
# Missing or wrong rejects the order and places nothing.
MONEY_DESK_APPROVAL_PASSWORD=

# xAI chat. The assistant section shows a needs-key state when this is empty.
XAI_API_KEY=
XAI_MODEL=

# The Odds API. Sports arbitrage shows a needs-key state when this is empty.
ODDS_API_KEY=

# Optional. The Weather Company forecast is attempted when this is set.
# Without it the scan says that forecast was unreachable.
WEATHER_COMPANY_API_KEY=

# Optional dollar bankroll used only for the quarter-Kelly suggestion
# when shard cash cannot be read. It is labeled as assumed.
MONEY_DESK_ASSUMED_BANKROLL=

# Optional directory for scan records and the order log. Defaults to data/money-desk.
MONEY_DESK_DATA_DIR=

# Optional override. Defaults to the public elections trade API.
KALSHI_API_BASE=

# Pick feed for the Trade Log tab. HTTPS only, no credentials in the URL.
# Defaults to data/money-desk-feed.json on branch money-desk-data of this repo.
MONEY_DESK_FEED_URL=
