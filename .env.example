# Defaults are paper, trading off, demo. Do not put real keys in this file.
MODE=PAPER
TRADING_ENABLED=false
KALSHI_ENV=demo

# Optional. Empty means no live orders.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=

MAX_CONTRACTS=10
MAX_ORDER_COST=10
PRICE_MOVE_TOLERANCE=0.02
PROPOSAL_TTL_MS=60000
PAPER_POLL_MS=20000
RISK_POLL_MS=10000
SHORT_HORIZON_REFRESH_MS=3600000

# Optional default stop for the next confirmed entry. Empty means no stop unless the request sets one.
# STOP_LOSS_PERCENT=0.2
# STOP_LOSS_DOLLARS=0.50

# Replit Postgres. Unset uses SQLite, then JSONL.
DATABASE_URL=

# Safety net. Returns are fractions. The banner never sells.
SAFETY_DANGER_POINT=-0.07
SAFETY_DANGER_LOWER90=-0.15
SAFETY_DANGER_P10=0.25
SAFETY_WATCH_POINT=-0.04
SAFETY_WATCH_LOWER90=-0.10
SAFETY_WATCH_P10=0.15
SAFETY_ACCEL=0.0001

# Projection nudge cap as a fraction of horizon sigma. Minute weight stays 0.
PROJECTION_SIGMA_CAP=0.25
